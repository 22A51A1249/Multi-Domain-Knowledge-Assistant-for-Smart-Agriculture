# Google Gemini API Key (Enter your Gemini / Google API Key below)
GEMINI_API_KEY=your_api_key_here
GOOGLE_API_KEY=your_api_key_here

# Google Gemini Models Configuration
GOOGLE_LLM_MODEL=gemini-3.5-flash
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001

# Document Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval & Generation Settings
TOP_K=5
TEMPERATURE=0.2
